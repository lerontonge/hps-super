alertcondition(superL, "Super Signal LONG",  "HPS Super Signal LONG on {{ticker}} ({{interval}})")
alertcondition(superS, "Super Signal SHORT", "HPS Super Signal SHORT on {{ticker}} ({{interval}})")
alertcondition(quadDivL, "Quad Divergence LONG",  "HPS Quad Divergence LONG on {{ticker}} ({{interval}})")
alertcondition(quadDivS, "Quad Divergence SHORT", "HPS Quad Divergence SHORT on {{ticker}} ({{interval}})")
alertcondition(quadVwapL, "Quad VWAP LONG",  "HPS Quad VWAP LONG on {{ticker}} ({{interval}})")
alertcondition(quadVwapS, "Quad VWAP SHORT", "HPS Quad VWAP SHORT on {{ticker}} ({{interval}})")
alertcondition(flagL, "20/20 Bull Flag LONG",  "HPS 20/20 bull flag LONG on {{ticker}} ({{interval}})")
alertcondition(flagS, "20/20 Bear Flag SHORT", "HPS 20/20 bear flag SHORT on {{ticker}} ({{interval}})")
alertcondition(basicL, "9-3 Divergence LONG",  "HPS 9-3 divergence LONG on {{ticker}} ({{interval}})")
alertcondition(basicS, "9-3 Divergence SHORT", "HPS 9-3 divergence SHORT on {{ticker}} ({{interval}})")
alertcondition(qrStartL, "Quad Rotation UP",   "HPS quad rotation UP on {{ticker}} ({{interval}})")
alertcondition(qrStartS, "Quad Rotation DOWN", "HPS quad rotation DOWN on {{ticker}} ({{interval}})")
alertcondition(tp1L or tp1S, "TP1 reached", "HPS TP1 on {{ticker}} ({{interval}})")
alertcondition(hitSL or hitSS, "Stop hit", "HPS stop hit on {{ticker}} ({{interval}})")
